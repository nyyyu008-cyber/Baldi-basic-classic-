dupBtn.Text = "Duplicate Books"
dupBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
dupBtn.TextSize = 14
dupBtn.Font = Enum.Font.GothamMedium
dupBtn.AutoButtonColor = false
