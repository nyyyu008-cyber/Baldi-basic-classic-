local dupBtnCorner = Instance.new("UICorner")
dupBtnCorner.CornerRadius = UDim.new(0, 8)
dupBtnCorner.Parent = dupBtn

dupBtn.MouseButton1Click:Connect(function()
    local count = tonumber(amountBox.Text) or 1
    count = math.clamp(count, 1, 100)
    
    local backpack = LocalPlayer:WaitForChild("Backpack")
    local character = LocalPlayer.Character
    
    -- Check for existing books held or in backpack
    local templateBook = nil
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and string.find(string.lower(item.Name), "book") then
            templateBook = item
            break
        end
    end
    
    if not templateBook and character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), "book") then
                templateBook = item
                break
            end
        end
    end
    
    -- Clone existing or generate new ones
    for i = 1, count do
        if templateBook then
            local cloned = templateBook:Clone()
            cloned.Parent = backpack
        else
            local newBook = createBookTool("Magic Book")
            newBook.Parent = backpack
        end
    end
end)

-- Toggle Menu Keybind (Right Control)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightControl then
        mainFrame.Visible = not mainFrame.Visible
    end
end)
