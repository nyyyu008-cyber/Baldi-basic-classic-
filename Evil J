-- Utility Function to Create Styled Buttons
local function createButton(text, layoutOrder)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(40, 44, 60)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamMedium
    btn.LayoutOrder = layoutOrder
    btn.AutoButtonColor = false
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(55, 60, 80)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 44, 60)}):Play()
    end)
    
    btn.Parent = container
    return btn
end

-- 1. God Mode Toggle
local godBtn = createButton("God Mode: OFF", 1)

local function enableGodMode(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
        if godModeConnection then godModeConnection:Disconnect() end
        godModeConnection = humanoid.HealthChanged:Connect(function()
            if isGodMode and humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = humanoid.MaxHealth
            end
        end)
    end
end

godBtn.MouseButton1Click:Connect(function()
    isGodMode = not isGodMode
    if isGodMode then
        godBtn.Text = "God Mode: ON"
        godBtn.TextColor3 = Color3.fromRGB(80, 255, 120)
        if LocalPlayer.Character then
            enableGodMode(LocalPlayer.Character)
        end
    else
        godBtn.Text = "God Mode: OFF"
        godBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        if godModeConnection then godModeConnection:Disconnect() end
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.MaxHealth = 100
            LocalPlayer.Character.Humanoid.Health = 100
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    if isGodMode then
        enableGodMode(char)
    end
end)

-- 2. Unlimited Items Toggle
local itemBtn = createButton("Infinite Items: OFF", 2)

itemBtn.MouseButton1Click:Connect(function()
    isInfiniteItems = not isInfiniteItems
    if isInfiniteItems then
        itemBtn.Text = "Infinite Items: ON"
        itemBtn.TextColor3 = Color3.fromRGB(80, 255, 120)
        
        backpackConnection = LocalPlayer.Backpack.ChildAdded:Connect(function(child)
            if child:IsA("Tool") and isInfiniteItems then
                child.AncestryChanged:Connect(function(_, parent)
                    if not parent and isInfiniteItems then
                        local clonedTool = child:Clone()
                        clonedTool.Parent = LocalPlayer.Backpack
                    end
                end)
            end
        end)
    else
        itemBtn.Text = "Infinite Items: OFF"
        itemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        if backpackConnection then backpackConnection:Disconnect() end
    end
end)

-- Helper Function: Build Tool Instance
local function createBookTool(name)
    local tool = Instance.new("Tool")
    tool.Name = name or "Magic Book"
    tool.RequiresHandle = true

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(1.2, 1.6, 0.3)
    handle.Color = Color3.fromRGB(140, 30, 40)
    handle.Material = Enum.Material.SmoothPlastic
    handle.Parent = tool

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Brick
    mesh.Parent = handle

    return tool
end

